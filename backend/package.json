{
  "name": "kg-mis-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KG-MIS Hybrid Market Intelligence System - Express/TypeScript REST API (6 epics per FDS/TDS v1.0)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --use-system-ca src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --use-system-ca dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:geely": "tsx scripts/seed-geely-products.ts",
    "db:seed:competitors": "tsx scripts/import-competitor-master.ts",
    "db:seed:history": "tsx scripts/seed-history.ts",
    "db:seed:tenders": "tsx scripts/seed-tender-sources.ts",
    "db:reclassify:tenders": "tsx scripts/reclassify-opportunities.ts",
    "db:rescore:tenders": "tsx scripts/rescore-opportunities.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.6",
    "pdfjs-dist": "^6.3.289",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
