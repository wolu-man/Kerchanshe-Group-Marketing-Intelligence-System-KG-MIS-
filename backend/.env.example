# =============================================================================
# KG-MIS Backend - environment configuration
# Copy to .env and fill in values. Never commit .env.
# Per SDD 7.4 all environment-specific settings are externalized.
# =============================================================================

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
SESSION_IDLE_MINUTES=120
# Public origin of the web portal (browser requests are blocked without this).
# NOT read from a default - must be set explicitly for any non-localhost deployment.
CORS_ORIGIN=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local SQL Server Express (dynamic port). Find yours:
#   sqlcmd -S .\SQLEXPRESS -E -C -Q "SELECT local_tcp_port FROM sys.dm_exec_connections WHERE session_id=@@SPID"
DB_HOST=localhost
DB_PORT=50404
DB_INSTANCE=SQLEXPRESS
DB_NAME=KG_MIS
DB_USER=kgmis_user
DB_PASSWORD=KgMis!2026Dev
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- CUAS (SSO). Production: SSO only, fail-secure. ------------------------
# Dev fallback login is enabled ONLY when CUAS_MOCK=true.
CUAS_MOCK=true
CUAS_SSO_URL=
CUAS_CLIENT_ID=
CUAS_CLIENT_SECRET=
CUAS_CALLBACK_URL=http://localhost:4000/api/v1/auth/callback
CUAS_TOKEN_ISSUER=
CUAS_CLAIMS_ROLE_FIELD=role

# --- D365FO (master data). Dev uses mock adapter when D365FO_MOCK=true. ----
D365FO_MOCK=true
D365FO_TENANT_ID=
D365FO_CLIENT_ID=
D365FO_CLIENT_SECRET=
D365FO_RESOURCE=
D365FO_BASE_URL=
D365FO_SYNC_CRON=0 6 * * *
D365FO_SYNC_ENABLED=true

# --- SMTP (email notifications) -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Power BI --------------------------------------------------------------
POWERBI_MOCK=true
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_GROUP_ID=
# Required by env.ts validation when POWERBI_MOCK=false:
POWERBI_DATASET_ID=
POWERBI_REPORT_IDS=

# --- Files (form uploads) --------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# --- AI Form Assistant -----------------------------------------------------
# Default provider used when the Form Builder asks for "auto".
# One of: auto | ollama | gemini | groq
AI_PROVIDER=auto
# Per-request timeout for AI provider calls (milliseconds).
AI_TIMEOUT_MS=60000

# Ollama (local / self-hosted). Backend-only - never exposed to the browser.
# Leave OLLAMA_MODEL empty to auto-pick the first installed non-embedding model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Google Gemini (cloud). Leave the key empty to disable the provider.
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq (cloud). Leave the key empty to disable the provider.
GROQ_API_KEY=
GROQ_MODEL=

# AI Key Rotation (configured via Admin UI / SystemConfig, not .env)
# ai.rotation.enabled=true
# ai.rotation.intervalDays=90
# ai.rotation.provider=gemini

# --- Tender & Opportunity Intelligence --------------------------------------
# Scheduled source collection (cron). Disabled by default in dev.
TENDERS_COLLECTION_ENABLED=false
TENDERS_COLLECTION_CRON=0 */6 * * *
# Daily deadline reminder cron.
TENDERS_REMINDER_CRON=0 9 * * *
# Days before deadline to send a reminder.
TENDERS_REMINDER_LEAD_DAYS=7
# Per-fetch timeout for source adapters (milliseconds).
TENDERS_FETCH_TIMEOUT_MS=30000
# Default per-source rate limit delay (milliseconds).
TENDERS_DEFAULT_RATE_LIMIT_MS=2000
# Relevance score threshold for "high relevance" (0-100).
TENDERS_HIGH_RELEVANCE_THRESHOLD=70
# Hosts with no authorized data-access method (comma-separated, suffix-matched).
# Sources on these hosts are stored inactive and never collected.
# Empty by default: e-GP, 2merkato and TenderInfo expose authorized public
# JSON APIs (TenderInfo keyless public mode; only the documented /api/export
# endpoint is used).
# Re-restrict with e.g. TENDERS_RESTRICTED_HOSTS=egp.gov.et,production.egp.gov.et
TENDERS_RESTRICTED_HOSTS=
# TenderMetro Intelligence REST API key (create one under Developer &
# integrations at https://app.tendermetro.com/developer). Interpolated into
# the source's Authorization header at request time — never stored in the DB.
# While empty, the TenderMetro source stays inactive and is never collected.
TENDERMETRO_API_KEY=
