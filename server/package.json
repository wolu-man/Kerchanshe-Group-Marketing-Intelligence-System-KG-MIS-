{
  "name": "kg-mis-server",
  "version": "1.0.0",
  "private": true,
  "description": "KG-MIS Express/Node.js/TypeScript API (business logic, validation, integration orchestration)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
