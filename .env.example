# ---------------------------------------------------------------------------
# KG-MIS environment configuration
# Copy to .env at the repo root (or set as process environment variables).
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- MS SQL Server (primary database) ---
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=KG_MIS
DB_ENCRYPT=false

# --- Application ---
NODE_ENV=development
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- CUAS (Corporate User Access System - SSO) ---
# When CUAS_SSO_ENABLED=false the server uses the local dev login (mock CUAS adapter).
CUAS_SSO_ENABLED=false
CUAS_AUTHORIZE_URL=
CUAS_TOKEN_URL=
CUAS_CLIENT_ID=
CUAS_CLIENT_SECRET=
CUAS_REDIRECT_URL=http://localhost:4000/api/v1/auth/callback

# --- D365FO (master data, OData/REST, read-only) ---
# When D365FO_MOCK=true the server uses the mock adapter so the app works offline.
D365FO_MOCK=true
D365FO_BASE_URL=
D365FO_TENANT_ID=
D365FO_CLIENT_ID=
D365FO_CLIENT_SECRET=
D365FO_RESOURCE=
D365FO_SYNC_CRON=0 6 * * *

# --- CNS (Corporate Notification System) ---
# When CNS_MOCK=true notifications are written to the Notification table only.
CNS_MOCK=true
CNS_BASE_URL=
CNS_API_KEY=

# --- Power BI ---
# When POWERBI_MOCK=true embed-token returns a placeholder and reports list is seeded.
POWERBI_MOCK=true
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
